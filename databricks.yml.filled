bundle:
  name: simple_identity_graph

variables:
  # Project name for the Identity Graph solution accelerator
  project_name:
    description: "A Databricks solution accelerator to build a Simple Identity Graph"
    default: "adtech-simple-identity-graph"
    
  # The "warehouse_id" variable is used to reference the warehouse used by the dashboard.
  warehouse_id:
    lookup:
      # Replace this with the name of your SQL warehouse.
      warehouse: "Shared Endpoint"
      
  # Environment variable used for deployment paths
  environment:
    description: "Deployment environment (dev, staging, prod)"
    default: "dev"

targets:
  dev:
    default: true
    mode: development
    workspace:
      # Deployment location will be under /Users/{current_user}/simple-identity-graph-dev
      root_path: /Users/${workspace.current_user.userName}/${var.project_name}-${var.environment}
  
  staging:
    mode: development
    workspace:
      root_path: /Users/${workspace.current_user.userName}/${var.project_name}-staging
  
  prod:
    mode: production
    workspace:
      root_path: /Shared/${var.project_name}-prod
    # Require approval before deploying to production
    run_as:
      service_principal_name: "your-service-principal"

# Resources for the Identity Graph solution accelerator
resources:
  # Identity Graph Dashboard
  dashboards:
    identity_graph_health:
      display_name: "Identity Graph Health - ${var.project_name}"
      file_path: "./notebooks/02_Dashboard_Insights/Identity Graph Health.lvdash.json"
      warehouse_id: "${var.warehouse_id}"

  # Main Identity Graph Workflow
  jobs:
    identity_graph_workflow:
      name: "${var.project_name} - Identity Graph Workflow"
      description: "Constructs a simple identity graph from advertising impression logs using a medallion architecture (Bronze → Silver → Gold)"
      
      # Email notifications
      email_notifications:
        on_failure:
          - "${workspace.current_user.email}"
        no_alert_for_skipped_runs: true
      
      # Optional: Schedule to run daily
      # trigger:
      #   pause_status: "UNPAUSED"
      #   periodic:
      #     interval: 1
      #     unit: "DAYS"
      
      # Performance target
      max_concurrent_runs: 1
      
      tasks:
        # Task 0: Create catalog (setup)
        - task_key: 00_create_catalog
          notebook_task:
            notebook_path: "./notebooks/01_Workflow_Orchestration/00_Create_Catalog.py"
            source: WORKSPACE
          new_cluster:
            spark_version: "14.3.x-scala2.12"
            node_type_id: "i3.xlarge"
            num_workers: 2
            spark_conf:
              "spark.databricks.delta.preview.enabled": "true"
        
        # Task 1: Create consolidated identity information (Silver layer)
        - task_key: 01_create_consolidated_identity_info
          depends_on:
            - task_key: 00_create_catalog
          notebook_task:
            notebook_path: "./notebooks/01_Workflow_Orchestration/01_Create Consolidated Identity Info.py"
            source: WORKSPACE
          new_cluster:
            spark_version: "14.3.x-scala2.12"
            node_type_id: "i3.xlarge"
            num_workers: 2
        
        # Task 2a: Create individual-level identity table (Email-IFA pairs)
        - task_key: 02a_create_email_ifa_pairs
          depends_on:
            - task_key: 01_create_consolidated_identity_info
          notebook_task:
            notebook_path: "./notebooks/01_Workflow_Orchestration/02a_Create Email IFA Paired Table.py"
            source: WORKSPACE
          new_cluster:
            spark_version: "14.3.x-scala2.12"
            node_type_id: "i3.xlarge"
            num_workers: 2
        
        # Task 2b: Create household-level identity table (Email-IP pairs)
        - task_key: 02b_create_email_ip_pairs
          depends_on:
            - task_key: 01_create_consolidated_identity_info
          notebook_task:
            notebook_path: "./notebooks/01_Workflow_Orchestration/02b_Create Email IP Paired Table.py"
            source: WORKSPACE
          new_cluster:
            spark_version: "14.3.x-scala2.12"
            node_type_id: "i3.xlarge"
            num_workers: 2
        
        # Task 3: Create final identity graph (Gold layer)
        - task_key: 03_create_identity_graph
          depends_on:
            - task_key: 02a_create_email_ifa_pairs
            - task_key: 02b_create_email_ip_pairs
          notebook_task:
            notebook_path: "./notebooks/01_Workflow_Orchestration/03_Create Identity Graph.py"
            source: WORKSPACE
          new_cluster:
            spark_version: "14.3.x-scala2.12"
            node_type_id: "i3.xlarge"
            num_workers: 2

# For more configuration options, see: https://docs.databricks.com/aws/en/dev-tools/bundles/settings

