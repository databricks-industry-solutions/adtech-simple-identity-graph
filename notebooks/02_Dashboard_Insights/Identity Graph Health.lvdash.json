{
  "datasets": [
    {
      "name": "f30d786f",
      "displayName": "Identity Graph",
      "queryLines": [
        "SELECT * FROM achu_demos.gold.identity_graph"
      ]
    },
    {
      "name": "473b4532",
      "displayName": "Primary IPs",
      "queryLines": [
        "WITH primary_ip_info AS (\n",
        "  SELECT \n",
        "COUNT(DISTINCT megacorp_id) as `Individuals`, \n",
        "Count(DISTINCT primary_ip) as `Primary IPs`,\n",
        "COUNT( DISTINCT CASE WHEN primary_ip IS NOT NULL THEN megacorp_id END) AS `Individuals with Primary IPs`  \n",
        "FROM achu_demos.gold.identity_graph)\n",
        "\n",
        "select *,`Individuals with Primary IPs` / `Individuals` as pct_matched from primary_ip_info"
      ]
    },
    {
      "name": "11d31999",
      "displayName": "Primary IFAs",
      "queryLines": [
        "\n",
        "with primary_ifa_info as (SELECT \n",
        "Count(DISTINCT megacorp_id) as `Individuals`, \n",
        "Count(DISTINCT primary_ifa) as `Primary IFAs`,\n",
        "COUNT( DISTINCT CASE WHEN primary_ifa IS NOT NULL THEN megacorp_id END) AS `Individuals with Primary IFAs`  \n",
        "FROM achu_demos.gold.identity_graph)\n",
        "\n",
        "select * from primary_ifa_info"
      ],
      "columns": [
        {
          "displayName": "Percent of Matched Individuals",
          "description": "",
          "expression": "`Primary IFAs` / `Individuals`"
        }
      ]
    },
    {
      "name": "a680857b",
      "displayName": "Identity and Server Email Analysis",
      "queryLines": [
        "with id_graph_emails as (\n",
        "  SELECT min_date, COUNT(DISTINCT email_sha256) as n_matched_emails \n",
        "  FROM achu_demos.gold.identity_graph\n",
        "  GROUP BY min_date),\n",
        "\n",
        "server_emails as (SELECT date, COUNT(DISTINCT request_kv._server_email) as server_emails \n",
        "FROM achu_demos.bronze.impression_logs_prod\n",
        "GROUP BY date)\n",
        "\n",
        "\n",
        "SELECT date, server_emails - n_matched_emails as `existing_emails`, n_matched_emails as `new_emails`\n",
        "FROM (SELECT COALESCE(date,min_date) as `date`, COALESCE(server_emails,0) as `server_emails`, COALESCE(n_matched_emails,0) as `n_matched_emails` \n",
        "FROM server_emails a FULL JOIN id_graph_emails b ON a.`date` = b.`min_date`)\n",
        "WHERE `date` > '2025-04-02'\n",
        "ORDER BY `date`"
      ]
    }
  ],
